# StressLab — variables de entorno (copia a .env)

# Puerto del servidor API
PORT=3000

# Motor de base de datos: better-sqlite3 (default) | mysql | pg
DB_CLIENT=better-sqlite3

# SQLite (DB_CLIENT=better-sqlite3)
DB_FILE=data/stresslab.db

# MySQL / PostgreSQL (DB_CLIENT=mysql o pg)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=stresslab

# Imagen de k6 usada cuando no hay k6 local (modo Docker)
K6_DOCKER_IMAGE=grafana/k6

# Directorio donde se guardan scripts y resúmenes temporales de corridas
RUNS_DIR=data/runs

# Proveedor de IA opcional: openrouter | openai | anthropic | bedrock
AI_PROVIDER=
# URLs HTTPS exactas permitidas para revisión pasiva (separadas por comas)
PASSIVE_TARGETS=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# Selección bedrock:
# Sin estas variables la importación y revisión de hallazgos funcionan igual;
# solo se deshabilita el botón "Analizar con IA".
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Ej: anthropic.claude-3-5-sonnet-20241022-v2:0 (debe estar habilitada en tu región)
BEDROCK_MODEL_ID=
