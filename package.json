{
    "name": "stresslab",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "Monolith for designing and running k6 stress tests.",
    "scripts": {
        "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
        "dev:api": "tsx watch server/src/index.ts",
        "dev:web": "vite --config frontend/vite.config.ts",
        "build": "npm run build:frontend && npm run build:server",
        "build:frontend": "vite build --config frontend/vite.config.ts",
        "build:server": "tsc -p server/tsconfig.json",
        "start": "node server/dist/index.js",
        "typecheck": "tsc -p server/tsconfig.json --noEmit && tsc -p frontend/tsconfig.json --noEmit",
        "test": "npm run typecheck && npm run build",
        "stress": "docker run --rm -i -v \"%cd%/tests/k6:/scripts:ro\" -e BASE_URL=http://host.docker.internal:3000/api/health grafana/k6 run /scripts/smoke.js",
        "start:docker": "docker compose up --build"
    },
    "dependencies": {
        "@tailwindcss/vite": "^4.3.5",
        "better-sqlite3": "^13.2.0",
        "express": "^5.1.0",
        "knex": "^3.3.0",
        "mysql2": "^3.24.6",
        "pg": "^8.23.1",
        "react": "^19.1.1",
        "react-dom": "^19.1.1",
        "recharts": "^3.10.1",
        "tailwindcss": "^4.3.5",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@types/better-sqlite3": "^9.6.0",
        "@types/express": "^5.0.3",
        "@types/node": "^24.3.0",
        "@types/react": "^19.1.10",
        "@types/react-dom": "^19.1.7",
        "@vitejs/plugin-react": "^5.0.2",
        "concurrently": "^9.2.1",
        "tsx": "^4.20.5",
        "typescript": "^5.9.2",
        "vite": "^7.1.3"
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "better-sqlite3"
        ]
    }
}
